#!/usr/bin/env bash
# ninfer-switch 27b|38|38u|35b|kill   -- swap model or shut down
#
# Defaults match the live deployment so that swapping a model does not strand a
# client pointed at it. Override with NINFER_PORT / NINFER_HOST / NINFER_KEY.
# An API key is sent only when NINFER_KEY is set.
set -eu

PORT="${NINFER_PORT:-18020}"
HOST="${NINFER_HOST:-0.0.0.0}"

case "${1:-}" in
  27b) ART=qwen3_6_27b.ninfer;      ID=qwen3.6-27b ;;
  38)  ART=qwen3_8_27b.ninfer;      ID=qwen3.8-27b ;;
  38u) ART=qwen3_8_27b_uncensored.ninfer; ID=qwen3.8-27b-heretic ;;
  35b) ART=qwen3_6_35b_a3b.ninfer;  ID=qwen3.6-35b-a3b ;;
  kill)
    p=$(ps -eo pid,comm --no-headers | awk '$2=="ninfer-serve"{print $1}')
    if [ -n "$p" ]; then
      kill "$p"
      for _ in $(seq 1 30); do ss -ltn 2>/dev/null | grep -q ":$PORT " || break; sleep 1; done
      echo "stopped ninfer-serve"
    else
      echo "no ninfer-serve running"
    fi
    exit 0
    ;;
  *) echo "usage: ninfer-switch 27b|38|38u|35b|kill"; exit 1 ;;
esac

p=$(ps -eo pid,comm --no-headers | awk '$2=="ninfer-serve"{print $1}')
[ -n "$p" ] && kill "$p"
for _ in $(seq 1 30); do ss -ltn 2>/dev/null | grep -q ":$PORT " || break; sleep 1; done

export LD_LIBRARY_PATH="$HOME/lib"
setsid nohup "$HOME/bin/ninfer-serve" "$HOME/models/$ART" \
  --model-id "$ID" --host "$HOST" --port "$PORT" \
  ${NINFER_KEY:+--api-key "$NINFER_KEY"} \
  --max-context "${NINFER_CTX:-262144}" --kv-capacity auto --kv-dtype int8 \
  --default-max-tokens "${NINFER_MAXTOK:-262144}" --cors \
  --spec mtp --draft-tokens 3 --lm-head-draft \
  --request-log-jsonl "$HOME/serve.jsonl" \
  </dev/null >"$HOME/serve.log" 2>&1 &

for _ in $(seq 1 60); do
  ss -ltn 2>/dev/null | grep -q ":$PORT " && { echo "serving $ID on $PORT"; exit 0; }
  sleep 1
done
echo "failed to start; see ~/serve.log"; tail -3 "$HOME/serve.log"; exit 1
